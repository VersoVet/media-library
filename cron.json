{
  "tasks": [
    {
      "id": "daily-health-check",
      "name": "Daily Health Check",
      "schedule": "0 0 * * *",
      "command": {"type": "script", "script": "/opt/onyx/forge/bin/onyx-health-check"},
      "timeout_seconds": 120,
      "enabled": true,
      "notify_on_failure": true
    },
    {
      "id": "scan-all-sources",
      "name": "Scan All Enabled Sources",
      "description": "Periodically scan all enabled media sources for new files",
      "schedule": "0 */6 * * *",
      "command": {
        "type": "endpoint",
        "endpoint": "/api/scanner/run",
        "method": "POST"
      },
      "timeout_seconds": 600,
      "enabled": true,
      "notify_on_failure": true
    }
  ]
}
